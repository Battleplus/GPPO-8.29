{
  "_说明": "态势输入接口模板 —— 上层态势理解模块 → 任务分配模块",
  "_字段速查": {
    "scenario_name":    "场景名称（仅备注，不参与计算）",
    "aoi":             "AOI 大区行列号，row 1-6, col 1-6，对应 300×300km 任务区的 6×6 划分",
    "staging_position": "集结区坐标 [x_km, y_km]，所有平台的初始出发位置",
    "commander_AOI":    "指挥官关注的 AOI 编号列表，如 [\"A_3_4\"]",
    "grid_weather":     "5 个栅格的天气系数，c0 巡逻区 + c1~c4 子区，w ∈ [0,1]，越大越不利",
    "platforms":        "平台兵力配置，按类型 UAV / HELI 分别指定数量、传感器、弹药",
    "targets":          "目标列表，可为空数组 []（纯侦察模式）",
    "sensor_params":    "可选，传感器固有参数，不填则使用默认值"
  },

  "scenario_name": "示例场景: AOI A_3_4, 5 UAV + 2 HELI + 4 目标",
